<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Relatório de Inspeção</title>
  <style>
    body {
      color: #333;
      font-family: Arial, sans-serif;
      margin: 20px;
    }

    h1,
    h2 {
      color: #333;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }

    th,
    td {
      border: 1px solid #d61a1a;
      padding: 8px;
      text-align: left;
    }

    th {
      background-color: #573c3c;
    }
  </style>
</head>

<body>
  <h1>Relatório de Inspeção</h1>

  <h2>Informações da Empresa</h2>
  <table>
    <thead>
      <tr>
        <th>Nome da Empresa</th>
        <th>Nome Fantasia</th>
        <th>CNPJ</th>
        <th>CEP</th>
        <th>Rua</th>
        <th>Número</th>
        <th>Bairro</th>
        <th>Cidade</th>
        <th>Estado</th>
      </tr>
    </thead>


    <tbody>
      <tr>
        <td>
          <%= company.nameCompany %>
        </td>
        <td>
          <%= company.tradeName %>
        </td>
        <td>
          <%= company.cnpj %>
        </td>
        <td>
          <%= company.cep %>
        </td>
        <td>
          <%= company.rua %>
        </td>
        <td>
          <%= company.numero %>
        </td>
        <td>
          <%= company.bairro %>
        </td>
        <td>
          <%= company.cidade %>
        </td>
        <td>
          <%= company.estado %>
        </td>
      </tr>
    </tbody>

  </table>
</body>

</html>