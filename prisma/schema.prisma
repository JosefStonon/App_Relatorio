generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @unique @default(uuid()) @db.Uuid
  name      String
  tradeName String    @unique
  cnpj      Int       @unique
  address   String
  machines  Machine[]

  @@index([name])
}

model Machine {
  id           String  @unique @default(uuid()) @db.Uuid
  avaliation   String
  nameMachine  String
  tagEquipment String  @unique
  haritage     Int     @unique
  utility      String?
  brenchModel  String
  serie        String?
  capacity     String?

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String   @unique @default(uuid()) @db.Uuid

  @@index([nameMachine])
}
