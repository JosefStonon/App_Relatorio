generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @unique @default(uuid()) @db.Uuid
  name      String
  tradeName String    @unique
  cnpj      String    @unique
  address   String
  machines  Machine[]

  @@index([name])
}

model Machine {
  id           String  @unique @default(uuid()) @db.Uuid
  nameMachine  String
  tagEquipment String  @unique
  haritage     Int     @unique
  utility      String?
  brenchModel  String
  serie        String?
  capacity     String?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String      @unique @default(uuid()) @db.Uuid
  avaliation Avaliation?

  @@index([nameMachine])
}

model Avaliation {
  id           String   @unique @default(uuid()) @db.Uuid
  date         DateTime
  categoryRisk String
  levelRisk    String
  riskDirect   String
  faceMachine  String
  onOff        String

  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  machineId String  @unique @default(uuid()) @db.Uuid

  @@index([date])
}
